{
  "mcpServers": {
    "playwright": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@0.0.82",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280,800",
        "--output-dir",
        "/tmp/ohirome-playwright",
        "--caps",
        "devtools"
      ]
    }
  }
}
